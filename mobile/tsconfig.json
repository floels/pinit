{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  // `e2e-tests/` uses the Detox types, which replace the global `expect`.
  // It has its own tsconfig. `ios/` and `android/` are generated by prebuild.
  "exclude": ["e2e-tests", "ios", "android"]
}
