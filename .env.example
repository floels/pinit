# Copy this file to .env and fill in values for local development.
# The backend's local settings use hardcoded values, so most of these
# are only needed when overriding defaults or running staging locally.

# Optional: override the Django secret key (local settings use a hardcoded default)
# DJANGO_SECRET_KEY=your-secret-key-here

# Optional: S3 credentials (leave empty to skip S3 integration in local dev)
S3_PINS_BUCKET_UPLOADER_ACCESS_KEY_ID=
S3_PINS_BUCKET_UPLOADER_SECRET_ACCESS_KEY=
